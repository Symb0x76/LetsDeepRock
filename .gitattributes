# ==============================================================================
# Unreal Engine .gitattributes  (UE 5.8 项目 —— 不使用 Git LFS)
# ==============================================================================
# 方案：二进制资源直接由普通 Git 管理（项目约 135MB，最大单文件 20MB，
#       远低于平台限制，无需 LFS，也不占用 LFS 配额）。
# 作用：
#   1) 用 -text / binary 标记二进制文件，禁止换行符转换（防止资源损坏）
#   2) 统一源码 / 文本文件的换行符处理
# 备注：若未来仓库体积膨胀，可再迁移到 LFS（把下方规则改为 filter=lfs ...）。
# ==============================================================================

# --- 默认：自动判定文本文件，工作区统一使用 CRLF ---
* text=auto eol=crlf

# ==============================================================================
# Unreal 资源文件 —— 明确标记为二进制（禁止换行符转换 / 禁止文本 diff）
# ==============================================================================
*.uasset  binary
*.umap    binary

# ==============================================================================
# 常见美术 / 音频 / 媒体二进制资源 —— 标记为二进制
# ==============================================================================
# 3D 模型
*.fbx     binary
*.obj     binary
*.3ds     binary
*.dae     binary
*.blend   binary

# 贴图 / 图片
*.png     binary
*.jpg     binary
*.jpeg    binary
*.tga     binary
*.bmp     binary
*.tif     binary
*.tiff    binary
*.exr     binary
*.hdr     binary
*.psd     binary

# 音频
*.wav     binary
*.mp3     binary
*.ogg     binary
*.flac    binary

# 视频
*.mp4     binary
*.mov     binary
*.avi     binary

# 字体
*.ttf     binary
*.otf     binary

# 其他二进制
*.bin     binary
*.pdf     binary
*.xlsx    binary
*.xlsm    binary
*.xls     binary

# ==============================================================================
# 源码 / 文本文件 —— 明确按文本处理（换行符归一化）
# ==============================================================================
*.cpp      text eol=crlf
*.h        text eol=crlf
*.hpp      text eol=crlf
*.c        text eol=crlf
*.cs       text eol=crlf
*.ini      text eol=crlf
*.uproject text eol=crlf
*.uplugin  text eol=crlf
*.md       text eol=crlf
*.txt      text eol=crlf
*.json     text eol=crlf
*.csv      text eol=crlf
*.py       text eol=crlf
*.pyw      text eol=crlf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.xml      text eol=crlf
*.yaml     text eol=crlf
*.yml      text eol=crlf
